{
  "openapi": "3.1.0",
  "info": {
    "title": "General Windows PowerShell Service",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://YOUR-GATEWAY.example"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/status": {
      "post": {
        "operationId": "status",
        "summary": "Get service version and execution policy.",
        "x-openai-isConsequential": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON envelope. ok=true contains result; execution submission is asynchronous.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "default": {
            "description": "Structured error: ok=false, error, request_id, service_version.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          }
        }
      }
    },
    "/exec": {
      "post": {
        "operationId": "exec",
        "summary": "Submit a PowerShell command. Poll get_job; pending_approval requires local human approval.",
        "x-openai-isConsequential": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string"
                  },
                  "cwd": {
                    "type": "string",
                    "description": "Existing absolute Windows working directory within allowed_roots."
                  },
                  "timeout": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Timeout in seconds, bounded by server configuration."
                  }
                },
                "additionalProperties": false,
                "required": [
                  "command",
                  "cwd"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON envelope. ok=true contains result; execution submission is asynchronous.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "default": {
            "description": "Structured error: ok=false, error, request_id, service_version.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          }
        }
      }
    },
    "/exec_script": {
      "post": {
        "operationId": "exec_script",
        "summary": "Submit an existing absolute .ps1 path with positional string arguments. Poll get_job.",
        "x-openai-isConsequential": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "cwd": {
                    "type": "string",
                    "description": "Existing absolute Windows working directory within allowed_roots."
                  },
                  "timeout": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Timeout in seconds, bounded by server configuration."
                  }
                },
                "additionalProperties": false,
                "required": [
                  "path",
                  "cwd"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON envelope. ok=true contains result; execution submission is asynchronous.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "default": {
            "description": "Structured error: ok=false, error, request_id, service_version.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          }
        }
      }
    },
    "/cancel": {
      "post": {
        "operationId": "cancel",
        "summary": "Cancel a pending or running job and its process tree.",
        "x-openai-isConsequential": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "job_id": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "job_id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON envelope. ok=true contains result; execution submission is asynchronous.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "default": {
            "description": "Structured error: ok=false, error, request_id, service_version.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          }
        }
      }
    },
    "/get_job": {
      "post": {
        "operationId": "get_job",
        "summary": "Get state, stdout, stderr, exit_code, duration in seconds, working_directory, invoked, audit_id, service_version, changed_files and truncation flags.",
        "x-openai-isConsequential": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "job_id": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "job_id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON envelope. ok=true contains result; execution submission is asynchronous.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "default": {
            "description": "Structured error: ok=false, error, request_id, service_version.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          }
        }
      }
    },
    "/read_file": {
      "post": {
        "operationId": "read_file",
        "summary": "Read a bounded file as base64; inspect truncated before decoding.",
        "x-openai-isConsequential": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "path"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON envelope. ok=true contains result; execution submission is asynchronous.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "default": {
            "description": "Structured error: ok=false, error, request_id, service_version.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          }
        }
      }
    },
    "/list_files": {
      "post": {
        "operationId": "list_files",
        "summary": "List a bounded single directory; inspect truncated.",
        "x-openai-isConsequential": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "path"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON envelope. ok=true contains result; execution submission is asynchronous.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "default": {
            "description": "Structured error: ok=false, error, request_id, service_version.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Response": {
        "type": "object",
        "required": [
          "ok",
          "request_id",
          "service_version"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "request_id": {
            "type": "string"
          },
          "service_version": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "result": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
